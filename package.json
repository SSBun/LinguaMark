{
  "name": "linguamark",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "tsc --noEmit",
    "setup:chrome": "playwright-core install chromium",
    "open:test-article": "npm run build && node scripts/open-test-article.mjs",
    "test": "node --test tests/annotations.test.ts",
    "test:picker": "npm run build && node tests/file-picker.mjs && node tests/directory-picker.mjs",
    "test:chrome": "npm run build && node tests/chrome.mjs",
    "verify": "npm run check && npm test && npm run test:picker && npm run test:chrome"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "^0.84.3",
    "@earendil-works/pi-ai": "^0.84.3",
    "@mermaid-js/mermaid-zenuml": "^0.2.3",
    "dompurify": "^3.4.14",
    "highlight.js": "^11.12.0",
    "katex": "^0.18.4",
    "markdown-it": "^15.0.1",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "markdown-it-texmath": "^1.0.0",
    "mermaid": "^11.17.2"
  },
  "devDependencies": {
    "@types/chrome": "^0.2.7",
    "@types/node": "^22.19.19",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.62.1",
    "typescript": "5.9.3"
  }
}
